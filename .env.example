# Configuración de Firebase.
#
# Estas claves NO son secretas: viajan dentro del bundle de cualquier app web.
# La seguridad real está en las reglas de Firestore/Storage y en la lista de
# dominios autorizados de Firebase Authentication.
#
# Solo hacen falta si quieres apuntar a un proyecto distinto al de
# firebase-applet-config.json (por ejemplo, para tener staging aparte).
# Copia este archivo a .env.local y rellena lo que quieras sobreescribir.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Dominio de correo con acceso permitido. Por defecto: iwait.io
VITE_ALLOWED_EMAIL_DOMAIN=""

# Espacio de datos del equipo en Firestore. Por defecto: iwait
VITE_TEAM_ID=""
